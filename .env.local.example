# ── Required ────────────────────────────────────────────────────────────────

# ElevenLabs — TTS + STT. Get from: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI — multi-agent interview + HMTI avatar image generation
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Image model: gpt-image-1, gpt-image-1.5, dall-e-3, etc.
OPENAI_IMAGE_MODEL=gpt-image-1

# Weights & Biases / Weave — tracing and evaluation
# Get from: https://wandb.ai/settings
WANDB_API_KEY=your_wandb_api_key_here

# Gmail — email notifications (no API key needed, just a Gmail app password)
# Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL_USER=you@gmail.com
EMAIL_PASS=pass

# Your deployed URL — used to build the results link in emails (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Vercel KV (Redis) — flow persistence across serverless instances
# Auto-injected when you link a KV store in Vercel dashboard → Storage
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# ── Speech-to-text provider ──────────────────────────────────────────────────

# Free local engines run in dev by default (npm run dev), ElevenLabs in production.
# Override per direction. See lib/voice/README.md for full setup.

# Speech-to-text: "elevenlabs" (cloud), "deepgram" (cloud, cheapest), or "whisper" (local openai-whisper).
# STT_PROVIDER=whisper
# Text-to-speech: "elevenlabs" (cloud) or "kokoro" (local kokoro-onnx).
# TTS_PROVIDER=kokoro

# Deepgram (only used when STT_PROVIDER=deepgram). Key from console.deepgram.com:
# DEEPGRAM_API_KEY=your_deepgram_api_key
# DEEPGRAM_MODEL=nova-3     # override the default model

# Point Node at your venv's python so local Whisper/Kokoro work without activating it.
# WHISPER_PYTHON=/abs/path/to/.venv/bin/python   # KOKORO_PYTHON falls back to this
# WHISPER_MODEL=base                             # tiny | base | small | medium | large
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=1.0
# KOKORO_MODEL=models/kokoro-v1.0.onnx
# KOKORO_VOICES=models/voices-v1.0.bin

# Local Whisper tuning (only used when STT_PROVIDER=whisper):
# WHISPER_MODEL=base        # tiny | base | small | medium | large
# WHISPER_PYTHON=python3    # interpreter to run whisper with (e.g. a venv path)

# ── Optional voice override ──────────────────────────────────────────────────

# Override the default ElevenLabs voice (George). Find IDs in the ElevenLabs voice library.
# Note: free-tier accounts can only use premade voices, not library voices.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ── Debug flags (dev only) ───────────────────────────────────────────────────
# See README for full explanation. Set to "true" to skip API calls during testing.

# Skip ElevenLabs TTS — questions appear in transcript but are not spoken
NEXT_PUBLIC_DEBUG_TTS=false

# Skip ElevenLabs STT — returns a canned response instead of transcribing mic input
NEXT_PUBLIC_DEBUG_STT=false

# Show agent domain labels and colored borders on chat bubbles
NEXT_PUBLIC_DEBUG_AGENTS=false

# Pre-fill the user ID input and hide the name field (auto-set to "debug-user" when either debug flag is true)
# NEXT_PUBLIC_DEFAULT_USER_ID=alice
